<Window x:Class="EventViewerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EventViewerWPF.ViewModels"
        mc:Ignorable="d"
        Title="Event Viewer Remote/Local Reader - (Export to JSON &amp; TXT)"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Filter / Configuration Area -->
            <RowDefinition Height="Auto" />
            <!-- Search & Actions Bar -->
            <RowDefinition Height="Auto" />
            <!-- Event Logs DataGrid -->
            <RowDefinition Height="*" MinHeight="150" />
            <!-- Grid Splitter -->
            <RowDefinition Height="5" />
            <!-- Event Details Panel -->
            <RowDefinition Height="220" MinHeight="100" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP CONFIGURATION PANEL ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel Orientation="Vertical">
                <!-- Line 1: Server and Credentials -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Server (IP / Hostname / 'localhost'):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" ToolTip="Remote Server IP (e.g. 10.131.3.34) or 'localhost'" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,14,5">
                        <CheckBox IsChecked="{Binding UseCustomCredentials}" Content="Use Custom Credentials" ToolTip="Check to provide Windows Administrator credentials for the remote machine" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" IsEnabled="{Binding UseCustomCredentials}">
                        <TextBlock Text="Domain (Optional):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0" IsEnabled="{Binding UseCustomCredentials}">
                        <TextBlock Text="Username:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" IsEnabled="{Binding UseCustomCredentials}">
                        <TextBlock Text="Password:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>
                </Grid>

                <!-- Line 2: Log Name, Date Window, Limit -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Log Channel:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />

                        <ComboBox Grid.Row="1" Grid.Column="0" 
                                  ItemsSource="{Binding AvailableLogNames}" 
                                  SelectedItem="{Binding SelectedLogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding SelectedLogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  SelectedIndex="0"
                                  IsEditable="True"
                                  ToolTip="Select or type event log channel (e.g. Application, System, Security)" />

                        <Button Grid.Row="1" Grid.Column="1" 
                                Command="{Binding RefreshChannelsCommand}"
                                Content="🔄" 
                                ToolTip="Refresh available log channels from target server"
                                Margin="4,0,0,0" Padding="8,4" 
                                Background="{StaticResource InputBg}" 
                                Foreground="{StaticResource TextPrimary}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="From Date:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="From Time:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding FromTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                        <TextBlock Text="To Date:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="To Time:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding ToTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,12,2">
                        <Button Content="Set 2026-09-27" Command="{Binding SetTargetDateCommand}" Background="{StaticResource InputBg}" Foreground="{StaticResource TextPrimary}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Quick shortcut to select 2026-09-27" />
                        <Button Content="Today" Command="{Binding SetTodayCommand}" Background="{StaticResource InputBg}" Foreground="{StaticResource TextPrimary}" Padding="8,4" FontSize="11" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Max Events:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding MaxRecords, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Line 3: Severity levels and Fetch / Export Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Levels:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                        <CheckBox Content="Critical" IsChecked="{Binding IncludeCritical}" />
                        <CheckBox Content="Error" IsChecked="{Binding IncludeError}" />
                        <CheckBox Content="Warning" IsChecked="{Binding IncludeWarning}" />
                        <CheckBox Content="Information" IsChecked="{Binding IncludeInformation}" />
                        <CheckBox Content="Verbose" IsChecked="{Binding IncludeVerbose}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="▶ Fetch Events" Command="{Binding LoadEventsCommand}" Background="{StaticResource AccentPrimary}" Margin="0,0,8,0" Padding="14,6" />
                        <Button Content="⏹ Cancel" Command="{Binding CancelCommand}" Background="{StaticResource AccentDanger}" Margin="0,0,14,0" Padding="12,6" />
                        <Button Content="💾 Save as JSON" Command="{Binding ExportJsonCommand}" Background="{StaticResource AccentSuccess}" Margin="0,0,6,0" Padding="12,6" ToolTip="Export current list of events to formatted JSON" />
                        <Button Content="📄 Save as Text" Command="{Binding ExportTextCommand}" Background="{StaticResource CardBorder}" Margin="0,0,0,0" Padding="12,6" ToolTip="Export current list of events to formatted TXT file" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= SEARCH & STATS BAR ================= -->
        <Border Grid.Row="1" Background="{StaticResource BgDark}" Padding="14,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,4"
                             ToolTip="Filter current events by keyword, Event ID, Provider or Source" />
                    <TextBlock Text="🔍 Filter events by message, source, or event ID..." 
                               Foreground="{StaticResource TextSecondary}" 
                               IsHitTestVisible="False" 
                               Margin="8,5,0,0"
                               Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Showing: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBlock Text="{Binding FilteredCount}" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" FontSize="12" />
                    <TextBlock Text=" of " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                    <TextBlock Text=" loaded" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= EVENT LOGS DATAGRID ================= -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredEvents}"
                  SelectedItem="{Binding SelectedEvent}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="{StaticResource BgDark}"
                  Foreground="{StaticResource TextPrimary}"
                  BorderThickness="0"
                  RowBackground="#1E1E2E"
                  AlternatingRowBackground="#242436"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource CardBorder}"
                  VerticalGridLinesBrush="Transparent"
                  RowHeight="28"
                  FontSize="12">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource CardBg}" />
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D3B5E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Level with colored badge -->
                <DataGridTemplateColumn Header="Level" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding LevelColor}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="10" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Time Created -->
                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="170" />

                <!-- Event ID -->
                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="80" />

                <!-- Source / Provider -->
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="190" />

                <!-- Task Category -->
                <DataGridTextColumn Header="Task" Binding="{Binding TaskCategory}" Width="120" />

                <!-- Message preview -->
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= GRID SPLITTER ================= -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource CardBorder}" ResizeDirection="Rows" />

        <!-- ================= EVENT DETAILS PANEL ================= -->
        <Border Grid.Row="4" Background="{StaticResource CardBg}" Padding="10,6">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Formatted Message -->
                <TabItem Header="Description">
                    <TextBox Text="{Binding SelectedEvent.Message, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1B1B29"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource CardBorder}"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="12"
                             Padding="8"
                             Margin="0,6,0,0" />
                </TabItem>

                <!-- TAB 2: Raw XML -->
                <TabItem Header="XML Data">
                    <TextBox Text="{Binding SelectedEvent.Xml, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1B1B29"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource CardBorder}"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="11"
                             Padding="8"
                             Margin="0,6,0,0" />
                </TabItem>

                <!-- TAB 3: Event Properties -->
                <TabItem Header="Metadata">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Time Created:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Severity Level:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.Level}" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Event ID:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.EventId}" Margin="0,2" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Provider / Source:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.Source}" Margin="0,2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Machine Name:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEvent.MachineName}" Margin="0,2" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Log Channel:" Foreground="{StaticResource TextSecondary}" Margin="0,2" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEvent.LogName}" Margin="0,2" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="5" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />

                <ProgressBar Grid.Column="1" 
                             IsIndeterminate="{Binding IsLoading}" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Width="160" Height="10" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
